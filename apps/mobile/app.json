{
  "expo": {
    "name": "taylin.ai",
    "slug": "taylin-ai",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d0d0d"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ai.taylin.app",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "taylin.ai needs speech recognition for voice search.",
        "NSMicrophoneUsageDescription": "taylin.ai needs microphone access for voice search.",
        "NSFaceIDUsageDescription": "taylin.ai uses Face ID to confirm purchases securely.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d0d0d"
      },
      "package": "ai.taylin.app",
      "permissions": [
        "RECORD_AUDIO",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "taylin.ai needs microphone access for voice search.",
          "speechRecognitionPermission": "taylin.ai needs speech recognition for voice search."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.515880393101-v217ndn3mfasbu5jfqbpa4v8cmvksjh5"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "taylin",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "3683ae5a-f550-4bac-9048-468ba3e3efb2"
      }
    },
    "owner": "iamgadgetboy"
  }
}
