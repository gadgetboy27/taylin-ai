# taylin.ai — Mobile App Environment Variables
# Copy this to .env and fill in real values. NEVER commit .env

# Supabase — public keys only, safe to ship in app bundle
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Your backend API (Railway, Fly.io, etc.)
EXPO_PUBLIC_API_URL=https://your-api.railway.app

# OneSignal push notifications
EXPO_PUBLIC_ONESIGNAL_APP_ID=your-onesignal-app-id

# NO AI keys here. ALL AI calls go through the backend.
# NO Stripe secret key here. Payment tokens only.
