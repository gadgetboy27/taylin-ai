# taylin.ai — Backend API Environment Variables
# Copy this to .env — NEVER commit .env

# Supabase — service role key, server only, NEVER in mobile app
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# AI — server side only, NEVER in mobile app
GEMINI_API_KEY=AIza...
ANTHROPIC_API_KEY=sk-ant-...

# NZBN — NZ Business Register (optional — seller NZBN verification skipped if not set)
# Get a free key at: https://api.business.govt.nz/
NZBN_API_KEY=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_CLIENT_ID=ca_...

# Amadeus
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test

# KitchenHub
KITCHENHUB_API_KEY=

# TrackingMore
TRACKINGMORE_API_KEY=

# OneSignal
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Rate limiting
RATE_LIMIT_SEARCHES_PER_HOUR=20
RATE_LIMIT_ORDERS_PER_DAY=10
# Brave AI Answers bills per call — this caps /research spend per user
RATE_LIMIT_RESEARCH_PER_HOUR=20

# Admin — shared key guarding /admin/*. Unset means every admin request 401s.
# Any random string; not a role system (see middleware/admin.ts).
ADMIN_API_KEY=

# Server
PORT=3001
NODE_ENV=development
