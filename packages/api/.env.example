# taylin.ai — Backend API Environment Variables
# Copy this to .env — NEVER commit .env

# Supabase — service role key, server only, NEVER in mobile app
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# AI — server side only, NEVER in mobile app
GEMINI_API_KEY=AIza...
ANTHROPIC_API_KEY=sk-ant-...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_CLIENT_ID=ca_...

# Amadeus
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test

# KitchenHub
KITCHENHUB_API_KEY=

# TrackingMore
TRACKINGMORE_API_KEY=

# OneSignal
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Rate limiting
RATE_LIMIT_SEARCHES_PER_HOUR=20
RATE_LIMIT_ORDERS_PER_DAY=10

# Server
PORT=3000
NODE_ENV=development
